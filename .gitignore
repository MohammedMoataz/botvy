# Tool checkout — not part of this product's history
/spec-kit/

# Dependencies
node_modules/
.pnpm-store/

# Env & secrets
.env
.env.*
!.env.example

# Runtime data
/data/
*.sqlite
*.sqlite-*

# Build output
dist/
build/
.next/
.output/
.wxt/
out/

# Generated contract artefacts are committed; their TS build output is not
packages/*/dist/

# Flutter / Android
**/ios/Pods/
**/android/.gradle/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Agent credentials (spec-kit warning: may store auth tokens)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS/editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
**/.idea/
**/*.iml

# Logs
*.log
npm-debug.log*

# Prisma-generated client output
**/generated/prisma/
legacy/apps/gateway/generated/

# TS incremental build info
*.tsbuildinfo

# Volume backups and dumps (large, local-only)
backups/

# MCP browser-tool scratch output
.playwright-mcp/

# Credential files - never commit
secrets/
# The Android client config carries an API key. The copy Gradle reads lives at
# apps/mobile/android/app/ (ignored there too); a stray copy here is a leak.
/google-services.json
**/android/app/google-services.json

# phase-pipeline handoff files
.harness/

# vitest writes a transient config next to the real one while it resolves
# TypeScript. It is deleted on a clean exit and left behind on a kill, so it
# must never be committable — one was staged once.
*.timestamp-*.mjs
