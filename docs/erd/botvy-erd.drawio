etry"><mxRectangle width="110" height="22" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="t_Overview___all_stores_dexie__6" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;html=1;" vertex="1" parent="t_Overview___all_stores_dexie"><mxGeometry y="172" width="430" height="22" as="geometry"/></mxCell><mxCell id="t_Overview___all_stores_dexie__6_0" value="local" style="shape=partialRectangle;connectable=0;fillColor=#ffffff;top=0;left=0;bottom=0;right=0;overflow=hidden;html=1;whiteSpace=wrap;fontStyle=1;fontSize=10;fontColor=#334155;align=center;" vertex="1" parent="t_Overview___all_stores_dexie__6"><mxGeometry x="0" width="130" height="22" as="geometry"><mxRectangle width="130" height="22" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="t_Overview___all_stores_dexie__6_1" value="meta" style="shape=partialRectangle;connectable=0;fillColor=#ffffff;top=0;left=0;bottom=0;right=0;overflow=hidden;html=1;whiteSpace=wrap;align=left;spacingLeft=6;fontSize=12;fontColor=#0f172a;" vertex="1" parent="t_Overview___all_stores_dexie__6"><mxGeometry x="130" width="190" height="22" as="geometry"><mxRectangle width="190" height="22" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="t_Overview___all_stores_dexie__6_2" value="device only" style="shape=partialRectangle;connectable=0;fillColor=#ffffff;top=0;left=0;bottom=0;right=0;overflow=hidden;html=1;whiteSpace=wrap;align=left;spacingLeft=6;fontSize=11;fontColor=#475569;" vertex="1" parent="t_Overview___all_stores_dexie__6"><mxGeometry x="320" width="110" height="22" as="geometry"><mxRectangle width="110" height="22" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ov_n8n" value="&lt;b&gt;Not drawn:&lt;/b&gt; n8n keeps its own SQLite (workflows and one credential — no member data). v1's tables still sit in the Postgres database, undeclared and untouched.&lt;br&gt;&lt;br&gt;&lt;b&gt;Every&lt;/b&gt; &lt;code&gt;userId&lt;/code&gt; in Mongo, drift and Dexie is &lt;code&gt;identity.users.id&lt;/code&gt; as a string — the stores are never joined." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f7f8f9;strokeColor=#64748b;align=left;verticalAlign=top;spacing=14;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="520" width="560" height="170" as="geometry"/></mxCell><mxCell id="ove_forwarder__worker____same_tx_outbox" value="forwarder (worker) · same-tx outbox" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#336791;strokeWidth=2.5;fontSize=12;fontColor=#336791;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_Overview___all_stores_identity__4" target="t_Overview___all_stores_contexts__28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ove_POST__sync___pull___push___17_entities" value="POST /sync · pull + push · 17 entities" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2.5;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="ov_mg" target="ov_mb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ove_POST__sync___pull___push___4_entities" value="POST /sync · pull + push · 4 entities" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2.5;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="ov_mg" target="ov_ex"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="PostgreSQL___Identity__Neon_" name="PostgreSQL · Identity (Neon)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:34px&quot;&gt;Identity store — PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#475569&quot;&gt;Neon (managed) · Prisma · migrate deploy only · the one context on PostgreSQL · backend/src/contexts/identity/infrastructure/prisma/schema.prisma&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="80" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b style=&quot;font-size:15px&quot;&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;
&lt;b style=&quot;color:#b45309&quot;&gt;PK&lt;/b&gt; primary key &amp;nbsp; &lt;b style=&quot;color:#1d4ed8&quot;&gt;FK&lt;/b&gt; enforced foreign key &amp;nbsp; &lt;b style=&quot;color:#2563eb&quot;&gt;ref&lt;/b&gt; logical reference (no constraint)&lt;br&gt;
&lt;b style=&quot;color:#15803d&quot;&gt;UK&lt;/b&gt; unique &amp;nbsp; &lt;i&gt;IX / UX / TTL&lt;/i&gt; — index rows at the foot of each table&lt;br&gt;
&lt;code&gt;type?&lt;/code&gt; nullable or optional &amp;nbsp;·&amp;nbsp; &lt;code&gt;a.b&lt;/code&gt; embedded field &amp;nbsp;·&amp;nbsp; &lt;code&gt;a[].b&lt;/code&gt; field of an embedded array&lt;br&gt;
&lt;span style=&quot;color:#64748b&quot;&gt;grey rows&lt;/span&gt; — bookkeeping columns shared by every row of that kind&lt;br&gt;&lt;br&gt;
&lt;span style=&quot;color:#1d4ed8&quot;&gt;━━&lt;/span&gt; enforced relation &amp;nbsp; &lt;span style=&quot;color:#64748b&quot;&gt;╍╍&lt;/span&gt; logical, same context &amp;nbsp; &lt;span style=&quot;color:#db2777&quot;&gt;╍╍&lt;/span&gt; logical, across contexts" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f6f7;strokeColor=#334155;align=left;verticalAlign=top;spacing=14;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="100" width="620" height="230" as="geometry"/></mxCell><mxCell id="pgnote" value="&lt;b style=&quot;font-size:15px&quot;&gt;Why these tables, and only these&lt;/b&gt;&lt;br&gt;&lt;br&gt;
Identity owns users, refresh tokens, devices and service clients. Every other context lives in MongoDB and refers to a member by &lt;code&gt;userId&lt;/code&gt; = &lt;code&gt;users.id&lt;/code&gt; as a string — no join crosses the stores.&lt;br&gt;&lt;br&gt;
&lt;code&gt;identity_outbox&lt;/code&gt; is written in the &lt;b&gt;same Prisma transaction&lt;/b&gt; as the change; the worker's forwarder copies each row into Mongo's &lt;code&gt;outbox&lt;/code&gt; and stamps &lt;code&gt;forwarded_at&lt;/code&gt;.&lt;br&gt;&lt;br&gt;
v1's tables are still present in this database and deliberately undeclared: &lt;code&gt;migrate deploy&lt;/code&gt; leaves them alone." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#336791;align=left;verticalAlign=top;spacing=14;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="620" height="230" as="geometry"/></mxCell><mxCell id="g_PostgreSQL___Identity__Neon__Members___sessions" value="Members &amp; sessions" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f3f6f8;strokeColor=#336791;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontSize=20;fontStyle=1;fontColor=#336791;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="380" width="975" height="702" as="geometry"/></mxCell><mxCell id="t_PostgreSQL___Identity__Neon__users" value="users&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;opacity:0.85&quot;&gt;model User&lt;/span&gt;" style="shape=table;startSize=40;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;whiteSpace=wrap;fillColor=#336791;fontColor=#ffffff;strokeColor=#336791;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontSize=14;shadow=1;" vertex="1" parent="g_PostgreSQL___Identity__Neon__Members___sessions"><mxGeometry x="36" y="62" width="406" height="326" as="geometry"/></mxCell><mxCell id="t_PostgreSQL___Identity__Neon__users__0" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;html=1;" vertex="1" parent="t_PostgreSQL___Identity__Neon__users"><mxGeometry y="40" width="406" height="22" as="geometry"/></mxCell><mxCell id="t_PostgreSQL___Identity__Neon__users__0_0" value="PK" style="shape=partialRectangle;connectable=0;fillColor=#ffffff;top=0;left=0;bottom=0;right=0;ov