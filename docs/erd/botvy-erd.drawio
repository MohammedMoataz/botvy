edge="1" parent="1" source="t_MongoDB___Contexts__Atlas__meal_suggestions__6" target="t_MongoDB___Contexts__Atlas__meals__0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_MongoDB___Contexts__Atlas__2178" value="MessageSent" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;endArrow=ERmandOne;startArrow=ERzeroToOne;endFill=0;startFill=0;strokeColor=#db2777;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#db2777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_MongoDB___Contexts__Atlas__usage_log__7" target="t_MongoDB___Contexts__Atlas__outbox__1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_MongoDB___Contexts__Atlas__2179" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeColor=#db2777;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#db2777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_MongoDB___Contexts__Atlas__sessions__10" target="t_MongoDB___Contexts__Atlas__suggestions__0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_MongoDB___Contexts__Atlas__2180" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeColor=#db2777;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#db2777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_MongoDB___Contexts__Atlas__suggestions__12" target="t_MongoDB___Contexts__Atlas__sessions__0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_MongoDB___Contexts__Atlas__2181" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;endArrow=ERzeroToMany;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeColor=#db2777;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#db2777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_MongoDB___Contexts__Atlas__programs__5" target="t_MongoDB___Contexts__Atlas__links__0"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="Mobile___drift_SQLite__v9_" name="Mobile · drift SQLite (v9)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:34px&quot;&gt;Phone store — drift on SQLite&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#475569&quot;&gt;mobile/lib/core/db/database.dart · schemaVersion 9 · a cache of the server plus the unsent queue — every bump needs a MigrationStrategy branch in the same change&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2000" height="80" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b style=&quot;font-size:15px&quot;&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;
&lt;b style=&quot;color:#b45309&quot;&gt;PK&lt;/b&gt; primary key &amp;nbsp; &lt;b style=&quot;color:#1d4ed8&quot;&gt;FK&lt;/b&gt; enforced foreign key &amp;nbsp; &lt;b style=&quot;color:#2563eb&quot;&gt;ref&lt;/b&gt; logical reference (no constraint)&lt;br&gt;
&lt;b style=&quot;color:#15803d&quot;&gt;UK&lt;/b&gt; unique &amp;nbsp; &lt;i&gt;IX / UX / TTL&lt;/i&gt; — index rows at the foot of each table&lt;br&gt;
&lt;code&gt;type?&lt;/code&gt; nullable or optional &amp;nbsp;·&amp;nbsp; &lt;code&gt;a.b&lt;/code&gt; embedded field &amp;nbsp;·&amp;nbsp; &lt;code&gt;a[].b&lt;/code&gt; field of an embedded array&lt;br&gt;
&lt;span style=&quot;color:#64748b&quot;&gt;grey rows&lt;/span&gt; — bookkeeping columns shared by every row of that kind&lt;br&gt;&lt;br&gt;
&lt;span style=&quot;color:#1d4ed8&quot;&gt;━━&lt;/span&gt; enforced relation &amp;nbsp; &lt;span style=&quot;color:#64748b&quot;&gt;╍╍&lt;/span&gt; logical, same context &amp;nbsp; &lt;span style=&quot;color:#db2777&quot;&gt;╍╍&lt;/span&gt; logical, across contexts&lt;br&gt;&lt;br&gt;Grey rows at the top of a synced table are the &lt;b&gt;SyncColumns&lt;/b&gt; mixin." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f6f7;strokeColor=#334155;align=left;verticalAlign=top;spacing=14;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="100" width="620" height="230" as="geometry"/></mxCell><mxCell id="mbnote" value="&lt;b style=&quot;font-size:15px&quot;&gt;How the phone reads these&lt;/b&gt;&lt;br&gt;&lt;br&gt;
• &lt;b&gt;SyncColumns&lt;/b&gt;: &lt;code&gt;updatedAt&lt;/code&gt; is this device's last edit; &lt;code&gt;baseUpdatedAt&lt;/code&gt; is the server's value for the version last pulled — a local edit never touches it.&lt;br&gt;
• &lt;code&gt;pendingOp != 'x'&lt;/code&gt; is NULL for a clean row: write &lt;code&gt;pendingOp.isNull() | pendingOp.equals(x).not()&lt;/code&gt;.&lt;br&gt;
• Arrays and embedded documents arrive as &lt;code&gt;*Json&lt;/code&gt; text columns.&lt;br&gt;
• The full-snapshot delete sweep skips rows with a &lt;code&gt;pendingOp&lt;/code&gt;; deltas carry tombstones.&lt;br&gt;
