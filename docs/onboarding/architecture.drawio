        <mxCell id="l-coach" value="nightly_coaching.json · every 5 min → /internal/coaching/tick&lt;br&gt;webhook botvy-coaching → /internal/coaching/program" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffedd5;strokeColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="320" y="200" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="l-sweep" value="reminder_sweep.json · every 5 min + webhook botvy-sweep&lt;br&gt;→ /internal/reminders/sweep · retry 3× / 5 s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffedd5;strokeColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="v-sweep" value="notifications_sweep.json · 5 min + botvy-sweep&lt;br&gt;→ /internal/notifications/sweep · ABSENT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="v-tick" value="rhythm_tick.json · cron → /internal/rhythm/tick&lt;br&gt;webhook botvy-rhythm → /internal/rhythm/prompt · ABSENT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="320" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="v-sug" value="session_suggestion.json · webhook botvy/session-scheduled&lt;br&gt;disabled by default · ABSENT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="v-digest" value="daily_digest.json (optional) · webhook botvy/firehose&lt;br&gt;ABSENT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="800" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="v-err" value="error_handler.json (v2) · token from $env.BOTVY_INTERNAL_TOKEN&lt;br&gt;ABSENT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1040" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="guard" value="ServiceTokenGuard · scopes internal:notifications internal:rhythm&lt;br&gt;internal:knowledge internal:ops" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="ep1" value="/internal/notifications/sweep · /internal/rhythm/tick&lt;br&gt;/internal/rhythm/prompt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="320" y="440" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="ep2" value="/internal/knowledge/ingest/:linkId · /internal/alerts&lt;br&gt;/internal/ops/heartbeat" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="hb" value="ops_heartbeats&lt;br&gt;stale &gt; 15 min → /health degraded" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=11;backgroundOutline=1;size=10;fillColor=#fce7f3;strokeColor=#be185d;" vertex="1" parent="1"><mxGeometry x="800" y="440" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="fanout" value="worker WebhookFanout · X-Botvy-Event · X-Botvy-Signature sha256 HMAC&lt;br&gt;(AUTOMATION_WEBHOOK_SECRET)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="320" y="560" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="receiver" value="n8n webhook node · verify the signature&lt;br&gt;dedupe on eventId in the body (static data)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffedd5;strokeColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="n-rule" value="n8n holds one credential (the service token) and no member data (constitution II). Every /internal route stamps a heartbeat; a silent 401 between n8n and the gateway once went unnoticed for days, which is why /health reports a stale job within 15 minutes." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1040" y="560" width="220" height="108" as="geometry" /></mxCell>
        <mxCell id="owner__editor__0" value="edits over the tunnel" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6d28d9;fontColor=#6d28d9;" edge="1" parent="1" source="owner" target="editor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-sweep__ep1__1" value="service token" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;" edge="1" parent="1" source="v-sweep" target="ep1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-tick__ep1__2" value="service token" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;" edge="1" parent="1" source="v-tick" target="ep1"><mxGeometry relative="1" as="geometry" /></mxCell>
