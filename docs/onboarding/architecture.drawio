        <mxCell id="record" value="classify yes/no in code · EN/AR word lists&lt;br&gt;record check-in · streak · answer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="320" y="200" width="200" height="60" as="geometry" /></mxCell>
