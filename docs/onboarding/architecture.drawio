        <mxCell id="athlete" value="Athlete" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fillColor=#ede9fe;strokeColor=#6d28d9;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="n8n" value="n8n&lt;br&gt;(workflow engine)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ede9fe;strokeColor=#6d28d9;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="backup" value="backup containers&lt;br&gt;(mongodump cron)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ede9fe;strokeColor=#6d28d9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1040" y="80" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="github" value="GitHub Actions&lt;br&gt;(CI/CD deployer)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ede9fe;strokeColor=#6d28d9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1280" y="80" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="fcm" value="Firebase Cloud Messaging&lt;br&gt;push delivery to the phone" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#f3f4f6;strokeColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="google" value="Google OAuth&lt;br&gt;sign-in identity provider (P1)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#f3f4f6;strokeColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="320" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="ollama" value="Ollama on the host GPU&lt;br&gt;qwen2.5:3b-instruct · one numCtx" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#f3f4f6;strokeColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="k-member" value="principal.kind = member&lt;br&gt;user JWT · REST, GraphQL, /ws" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="800" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="k-admin" value="principal.kind = admin&lt;br&gt;user JWT + admin role · admin/* and admin GraphQL fields" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="1040" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="k-service" value="principal.kind = service&lt;br&gt;hashed scoped token · /internal/* only · refused on /ws" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="1280" y="320" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="n-owner" value="OWNER — the first user and administrator. Installs Botvy on one machine, invites family or friends, reads /health and the admin overview, retunes settings, reaches the n8n editor over an SSH tunnel. Cares that nothing leaves the house and that a stopped job is visible. (spec.md personas)" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="220" height="108" as="geometry" /></mxCell>
        <mxCell id="n-member" value="MEMBER — phone all day, PC while working. Wants one place for tasks, meetings, reminders and training; a coach that remembers body, food and goals; English or Arabic; every default editable. Offline must still work." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="320" y="200" width="220" height="108" as="geometry" /></mxCell>
        <mxCell id="n-athlete" value="ATHLETE — a Member with sports. Picks sports and weekly slots, follows programs found online, wants tomorrow's practice planned after the 21:00 cut-off and surfaced with the rest of tomorrow." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="220" height="108" as="geometry" /></mxCell>
        <mxCell id="n-n8n" value="n8n — a clock, not a brain. Holds one service token and no member data (constitution II). Cron ticks every 5 minutes into /internal/*; receives HMAC-signed event webhooks from the worker. Owner-only editor on 127.0.0.1:5679." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="220" height="108" as="geometry" /></mxCell>
        <mxCell id="n-backup" value="BACKUP CONTAINERS — nightly mongodump (and the postgres script) write archives to backups/ and report a heartbeat through /internal/ops/heartbeat with the service token: the only way a non-interface process may touch a store." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1040" y="200" width="220" height="108" as="geometry" /></mxCell>
        <mxCell id="n-github" value="GITHUB ACTIONS — runs CI on every push and PR; on a v* tag builds GHCR images, the APK and the extension zip, then deploys over SSH (compose pull, up, bootstrap, verify). Not a principal: it never calls the API." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1280" y="200" width="220" height="108" as="geometry" /></mxCell>
        <mxCell id="n-ext" value="EXTERNALS the platform talks to but does not own. FCM only wakes a phone that has not synced; the alarms are already local. Google is an identity provider, not a data store. Ollama is the only model — no cloud model call, ever (constitution III)." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="700" height="60" as="geometry" /></mxCell>
        <mxCell id="n-kinds" value="THREE PRINCIPAL KINDS (constitution VI). The two token schemes cannot be substituted: ServiceTokenGuard refuses a user JWT and the /ws handshake refuses a service token. Owner signs in as admin; Member and Athlete as member; n8n and the backup job as service." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="800" y="440" width="700" height="60" as="geometry" /></mxCell>
        <mxCell id="owner__k-admin__0" value="signs in as" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6d28d9;fontColor=#6d28d9;" edge="1" parent="1" source="owner" target="k-admin"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="member__k-member__1" value="signs in as" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6d28d9;fontColor=#6d28d9;" edge="1" parent="1" source="member" target="k-member"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="athlete__k-member__2" value="signs in as" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6d28d9;fontColor=#6d28d9;" edge="1" parent="1" source="athlete" target="k-member"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n8n__k-service__3" value="authenticates as" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6d28d9;fontColor=#6d28d9;" edge="1" parent="1" source="n8n" target="k-service"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="backup__k-service__4" value="authenticates as" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#6d28d9;fontColor=#6d28d9;" edge="1" parent="1" source="backup" target="k-service"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="legend" value="LEGEND — colour carries meaning&lt;br&gt;stick figure · a person (Owner, Member, Athlete)&lt;br&gt;violet dashed · a machine actor with its own credential&lt;br&gt;grey dashed · an external system (FCM, Google, GitHub, Ollama)&lt;br&gt;green · an API process or module (backend, worker)&lt;br&gt;&lt;br&gt;violet open arrow · a person or machine uses a surface" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1520" y="80" width="230" height="113" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
