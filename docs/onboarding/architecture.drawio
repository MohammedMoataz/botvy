        <mxCell id="dispatch" value="dispatch the command to its context · confirm with a template&lt;br&gt;no second inference · list → structured chat.card" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry x="1040" y="200" width="200" height="60" as="geometry" /></mxCell>
