        <mxCell id="guard__ep2__5" value="guards" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;rounded=0;endArrow=block;endFill=1;strokeColor=#374151;" edge="1" parent="1" source="guard" target="ep2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep1__hb__6" value="stamp" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;endArrow=open;endFill=0;strokeColor=#be185d;fontColor=#9d174d;" edge="1" parent="1" source="ep1" target="hb"><mxGeometry relative="1" as="geometry" /></mxCell>
