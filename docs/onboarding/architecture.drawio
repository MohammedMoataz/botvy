        <mxCell id="receiver__v-sug__10" value="triggers" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;endArrow=block;endFill=1;strokeColor=#15803d;fontColor=#15803d;" edge="1" parent="1" source="receiver" target="v-sug"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="receiver__v-digest__11" value="triggers" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;endArrow=block;endFill=1;strokeColor=#15803d;fontColor=#15803d;" edge="1" parent="1" source="receiver" target="v-digest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l-coach__ep1__12" value="INFERRED · v1 paths · would 404 on v2" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="l-coach" target="ep1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="legend" value="LEGEND — colour carries meaning&lt;br&gt;stick figure · a person (Owner, Member, Athlete)&lt;br&gt;orange · scheduled or automated work (n8n, cron, CI)&lt;br&gt;green · an API process or module (backend, worker)&lt;br&gt;red dashed · named by a task or plan but ABSENT on disk&lt;br&gt;rose cylinder · a server store or volume&lt;br&gt;&lt;br&gt;violet open arrow · a person or machine uses a surface&lt;br&gt;solid arrow · a synchronous call (HTTP, driver, function)&lt;br&gt;rose open arrow · data read or written&lt;br&gt;green dashed arrow · an event, push or change stream (asynchronous)&lt;br&gt;grey dashed · INFERRED, not traced to a file" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fffbeb;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1760" y="80" width="230" height="178" as="geometry" /></mxCell>
