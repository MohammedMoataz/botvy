{
  "name": "Botvy Nightly Coaching",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "c1a10000-0000-4000-8000-000000000001",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-240, 0],
      "notes": "A dumb clock. The check-in and program times are per user and in the user's own timezone, so a fixed 21:00/22:00 trigger here could only ever be right for one of them - the gateway decides whose time has come."
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "botvy-coaching",
        "options": {}
      },
      "id": "c1a10000-0000-4000-8000-000000000003",
      "name": "Manual Run Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-240, 180],
      "webhookId": "c1a10000-0000-4000-8000-000000000003",
      "notes": "Companion trigger so the gateway's POST /workflows/:id/run can fire the program push on demand - n8n's public API has no execute-now."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://gateway:8080/internal/coaching/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Token",
              "value": "={{ $env.INTERNAL_SERVICE_TOKEN }}"
            }
          ]
        },
        "options": { "timeout": 600000 }
      },
      "id": "c1a10000-0000-4000-8000-000000000006",
      "name": "Coaching Tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000,
      "notes": "Idempotent: the gateway claims each user's local date before sending, so five-minute ticks ask once a day and a gateway that was down at the user's time still catches up. Long timeout because a firing tick generates plans through the local model."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://gateway:8080/internal/coaching/program",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Token",
              "value": "={{ $env.INTERNAL_SERVICE_TOKEN }}"
            }
          ]
        },
        "options": { "timeout": 600000 }
      },
      "id": "c1a10000-0000-4000-8000-000000000005",
      "name": "Push Programs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 180],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000,
      "notes": "On-demand path only, and deliberately unconditional: an operator running this by hand wants the programs sent now, not a time check."
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [[{ "node": "Coaching Tick", "type": "main", "index": 0 }]]
    },
    "Manual Run Webhook": {
      "main": [[{ "node": "Push Programs", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "BotvyErrorHandler"
  },
  "tags": [{ "name": "botvy" }]
}
