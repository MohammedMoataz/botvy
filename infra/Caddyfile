# The single public surface.
#
# Everything the outside world can reach comes through here, and nothing else
# publishes a port beyond loopback. The routes below are the whole of the
# platform's public API; PostgreSQL, Mongo, n8n, the worker and the model server
# are on the Docker network and are not reachable from here at all.

{$CADDY_SITE} {
	encode zstd gzip

	# The API's surfaces. Commands, queries and the live connection are three
	# separate channels behind the same credential check, which is why they are
	# listed separately rather than proxied as one prefix.
	@api path /api/* /graphql /health /media /media/* /docs /docs/*
	handle @api {
		reverse_proxy backend:8080
	}

	# The socket. Long-lived, so it gets no read timeout: a chat turn can take
	# longer than a request, and cutting it off mid-answer looks to the member
	# like the assistant stopped talking.
	handle /ws* {
		reverse_proxy backend:8080 {
			transport http {
				read_timeout 0
			}
		}
	}

	# Everything else is the web app: the marketing pages and the admin portal.
	handle {
		reverse_proxy frontend:3000 {
			# THE CONTENT SECURITY POLICY SWITCH (E-025).
			#
			# `CSP_ENFORCE=on` in .env, then `docker compose up -d caddy`, turns
			# the policy from `Content-Security-Policy-Report-Only` into
			# `Content-Security-Policy`. Anything else — including nothing —
			# reports. That is the one line to flip.
			#
			# The policy itself is set by `frontend/middleware.ts` and not here,
			# because it carries a per-request nonce and Caddy cannot mint one.
			# Setting a second, nonce-less copy at the edge would not add a
			# policy: two headers of the same name are *intersected*, so the
			# edge's copy would forbid the inline bootstrap script the app's
			# copy allows, and the portal would render as a blank page.
			#
			# `header_up` replaces whatever arrived, so a client cannot enforce
			# — or un-enforce — the policy by sending this header itself.
			header_up X-Botvy-Csp-Enforce {$CSP_ENFORCE:off}
		}
	}

	header {
		# The edge owns these, so every surface gets them whether or not its own
		# framework remembered to. `Content-Security-Policy` is deliberately not
		# among them: this block covers `@api` too, and a script-source
		# directive on a JSON response protects nothing while breaking the
		# Swagger UI and the GraphQL playground. It belongs to the web app's own
		# responses — see the switch above.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}
