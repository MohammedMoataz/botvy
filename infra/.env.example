# Copy this file to E:\Work\botvy\.env and fill in real values.
# infra/docker-compose.yml is run with `--env-file ../.env` (or from repo
# root with a symlink/copy) — see infra/docs for exact invocation.

### Postgres (feature 001-foundation) ###
POSTGRES_USER=botvy
POSTGRES_PASSWORD=                    # generate: any strong random string
POSTGRES_DB=botvy

### n8n (feature 001-foundation) ###
N8N_VERSION=2.27.4                    # pinned; same version the old reference stack uses
N8N_ENCRYPTION_KEY=                   # generate: any strong random string — BACK THIS UP, losing it makes n8n's stored credentials unrecoverable
TZ=Africa/Cairo

### Cloudflare named tunnel (feature 001-foundation, User Story 3) ###
# Only required to run `docker compose --profile tunnel up -d`.
# Without these, use the default profile (LAN-only): `docker compose up -d`
# (cloudflared has `profiles: ["tunnel"]` so it is skipped by default).
TUNNEL_TOKEN=                         # from `cloudflared tunnel create <name>` / Cloudflare Zero Trust dashboard
BOTVY_PUBLIC_HOSTNAME=                # e.g. botvy.yourdomain.com — the hostname you route to this tunnel

### Ollama (feature 001-foundation) ###
# Not a compose var — Ollama runs natively on the host, not in Docker.
# Configured via OLLAMA_HOST/OLLAMA_KEEP_ALIVE user environment variables.
# See infra/docs/ollama-setup.md.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_CHAT_MODEL=qwen3:4b
