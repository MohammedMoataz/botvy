# The environment contract. Copy to .env at the repository root and fill it in.
#
# Three kinds of configuration live in three places, and this file is only the
# first: secrets and connection details are environment variables; anything an
# operator might retune is a key in the settings registry, editable from the
# portal without a restart; anything a member might want different is a
# preference. If you find yourself wanting to add a tunable here, it probably
# belongs in the registry instead.
#
# Every value marked REQUIRED is enforced twice: compose refuses to start
# without it, and the API validates the whole set at boot and dies naming
# whatever is wrong. A process that starts half-configured fails later,
# somewhere that does not mention the variable that caused it.

# ---------------------------------------------------------------- stores
# REQUIRED. Identity lives here; so does n8n, in its own database.
POSTGRES_USER=botvy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=botvy
DATABASE_URL=postgresql://botvy:change-me@postgres:5432/botvy

# REQUIRED. Everything that is not Identity. The replica set is not optional:
# transactions and change streams both need one, and the outbox needs both.
MONGO_URL=mongodb://mongo:27017/botvy?replicaSet=rs0&directConnection=true

# ---------------------------------------------------------------- credentials
# REQUIRED, and each at least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# REQUIRED. The one credential n8n holds. It is passed to the n8n container as
# BOTVY_INTERNAL_TOKEN so the committed workflows authenticate without storing a
# credential of their own, and the backend hashes it into the n8n service client
# at boot. Changing it rotates the hash on the next start.
INTERNAL_SERVICE_TOKEN=

# REQUIRED. Signs outgoing webhooks so a subscriber can tell a real delivery
# from anything else that finds the URL.
AUTOMATION_WEBHOOK_SECRET=

# REQUIRED. Signs the image URLs the media proxy will fetch.
MEDIA_SIGNING_SECRET=

# ---------------------------------------------------------------- the edge
# What Caddy serves. A bare ":80" is plain HTTP behind a tunnel that terminates
# TLS; a hostname makes Caddy obtain its own certificate.
CADDY_SITE=:80
EDGE_PORT=80

# Only for a tunnelled host. Leave empty and the profile stays off.
TUNNEL_TOKEN=

# Which origins the browser may call the API from. Empty means same-origin
# only, which is what running behind Caddy gives you.
CORS_ORIGINS=

# ---------------------------------------------------------------- neighbours
# The model server. Host-native, so the container reaches back out to the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Where n8n's editor is bound. Loopback, so it is reachable through an SSH
# tunnel and not from the internet. Change the address, or delete the service's
# ports entry entirely, on a host where something already holds this port.
N8N_BIND=127.0.0.1:5679
N8N_HOST=localhost
N8N_DB=n8n
N8N_API_KEY=
GENERIC_TIMEZONE=Africa/Cairo

# ---------------------------------------------------------------- push
# Optional. Leave empty and push is simply off, which is a working system.
# Set it and the file must be readable at boot, or the process refuses to start:
# naming a credentials file is a declared intent to have notifications, and a
# process that starts quietly without them notifies nobody until someone looks.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_DIR=./secrets

# ---------------------------------------------------------------- the Owner
# The account the seed creates on a fresh install. It is never reset once it
# exists, so a password changed in the portal survives every restart — and the
# portal warns while these are still the defaults.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin

# ---------------------------------------------------------------- operations
NODE_ENV=production
LOG_LEVEL=info

# When the nightly dump runs. A deployment detail, and the job is a container
# rather than the API — which is why this is here and the retention window is a
# settings key instead.
BACKUP_CRON=0 3 * * *

# Which images compose runs. The release workflow rewrites this line on deploy.
BOTVY_TAG=local
GITHUB_OWNER=botvy
