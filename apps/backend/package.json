{
  "name": "@botvy/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "cross-env BOTVY_ROLE=backend nest start --watch",
    "dev:worker": "cross-env BOTVY_ROLE=worker nest start --watch",
    "dev:token": "tsx scripts/dev-token.ts",
    "prisma:generate": "prisma generate --schema src/contexts/identity/infrastructure/prisma/schema.prisma",
    "postinstall": "prisma generate --schema src/contexts/identity/infrastructure/prisma/schema.prisma",
    "build": "prisma generate --schema src/contexts/identity/infrastructure/prisma/schema.prisma && nest build",
    "build:clean": "node -e \"const{rmSync}=require('node:fs');for(const p of ['dist','tsconfig.build.tsbuildinfo','tsconfig.tsbuildinfo'])rmSync(p,{recursive:true,force:true})\" && nest build",
    "//typecheck": "Two projects, deliberately. tsconfig.build.json excludes **/*.spec.ts because that is what ships; tsconfig.json includes the specs, the fixtures and the scripts. Only the first ran here until P5, so a type error in a spec was invisible to every gate that recorded `pnpm typecheck` as green - three agents in one phase hit it independently, one of them shipping a call with the wrong arity. A check that cannot see half the tree is a check that has recorded something other than what it says.",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --config ../../oxlint.json src",
    "migrate:pg": "prisma migrate deploy --schema src/contexts/identity/infrastructure/prisma/schema.prisma",
    "migrate:pg:status": "prisma migrate status --schema src/contexts/identity/infrastructure/prisma/schema.prisma",
    "migrate:mongo": "migrate-mongo up -f migrate-mongo-config.cjs",
    "gen:contracts": "cross-env BOTVY_GEN=1 node dist/main.js"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.0.2",
    "google-auth-library": "^11.0.2",
    "graphql": "^16.10.0",
    "helmet": "^8.0.0",
    "jsdom": "^30.0.1",
    "jsonwebtoken": "^9.0.2",
    "migrate-mongo": "^11.0.0",
    "mongoose": "^8.9.4",
    "nestjs-pino": "^4.2.0",
    "ollama": "^0.5.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.4.0",
    "prisma": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5",
    "youtubei.js": "^18.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^2.1.8"
  }
}
