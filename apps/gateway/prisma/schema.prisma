generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum UserStatus {
  active
  banned
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  displayName  String?      @map("display_name")
  role         Role         @default(user)
  status       UserStatus   @default(active)
  createdAt    DateTime     @default(now()) @map("created_at")
  lastLoginAt  DateTime?    @map("last_login_at")

  refreshTokens RefreshToken[]
  messages      Message[]
  usageLogs     UsageLog[]
  devices       Device[]
  reminders     Reminder[]
  coaching      CoachingProfile?
  checkins      CheckIn[]
  workouts      WorkoutRecord[]

  @@map("users")
}

model Device {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  installId  String    @unique @map("install_id")
  name       String?
  platform   String
  fcmToken   String?   @map("fcm_token")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")

  @@index([userId])
  @@map("devices")
}

enum ReminderStatus {
  active
  done
  cancelled
}

model Reminder {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  remindAt  DateTime       @map("remind_at")
  status    ReminderStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at")

  notifications ReminderNotification[]

  @@index([userId, remindAt])
  @@map("reminders")
}

model ReminderNotification {
  id         String    @id @default(uuid())
  reminderId String    @map("reminder_id")
  reminder   Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  notifyAt   DateTime  @map("notify_at")
  label      String
  sentAt     DateTime? @map("sent_at")

  // Partial index over unsent rows only: the sweep's hot query. Carried
  // forward from the predecessor system, where it was the one index that
  // mattered at 288 sweeps/day.
  @@unique([reminderId, label])
  @@index([notifyAt], map: "idx_notifications_due")
  @@map("reminder_notifications")
}

model CoachingProfile {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  optedIn   Boolean @default(false) @map("opted_in")
  timezone  String  @default("UTC")

  weightKg  Float?  @map("weight_kg")
  heightCm  Float?  @map("height_cm")
  goal      String?
  experience String?

  likedFoods    String[] @default([]) @map("liked_foods")
  dislikedFoods String[] @default([]) @map("disliked_foods")
  // Treated as a hard constraint: a generated plan containing any of these
  // is withheld, not delivered with a warning (the predecessor's behaviour).
  allergies     String[] @default([]) @map("allergies")

  // ISO weekday numbers (1 = Monday). Days NOT listed are rest days.
  trainingDays Int[]   @default([]) @map("training_days")
  gymTime      String? @map("gym_time")

  // Nightly check-in state. `awaitingSince` bounds how long a reply is
  // interpreted as an answer, so an unrelated message the next day is not
  // filed as one.
  awaitingCheckin Boolean   @default(false) @map("awaiting_checkin")
  awaitingSince   DateTime? @map("awaiting_since")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coaching_profiles")
}

model CheckIn {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkinDate String   @map("checkin_date") // local calendar date, YYYY-MM-DD
  adhered     Boolean
  rawReply    String?  @map("raw_reply")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, checkinDate])
  @@map("checkins")
}

enum WorkoutSource {
  /** The user told us they did this. Authoritative — a plan never overwrites it. */
  reported
  /** Generated by the nightly program push. */
  planned
}

model WorkoutRecord {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDate  String        @map("workout_date") // local calendar date, YYYY-MM-DD
  source       WorkoutSource
  exercises    String[]      @default([])
  muscleGroups String[]      @default([]) @map("muscle_groups")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")

  @@unique([userId, workoutDate])
  @@map("workout_records")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum MessageRole {
  user
  assistant
}

model Message {
  id        Int         @id @default(autoincrement())
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([userId, id(sort: Desc)])
  @@map("messages")
}

enum UsageKind {
  chat
  task
}

model UsageLog {
  id               Int       @id @default(autoincrement())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             UsageKind
  model            String
  promptTokens     Int       @map("prompt_tokens")
  completionTokens Int       @map("completion_tokens")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("usage_log")
}
