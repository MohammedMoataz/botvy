{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning.TaskDeferred",
  "description": "Payload of planning.TaskDeferred. It travels inside the envelope in envelope.schema.json.",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "fromDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "toDate": {
      "type": "string",
      "format": "date-time"
    },
    "deferCount": {
      "type": "integer"
    }
  },
  "required": [
    "taskId",
    "fromDate",
    "toDate",
    "deferCount"
  ],
  "additionalProperties": false
}
